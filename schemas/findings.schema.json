{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/findings.schema.json",
  "title": "auditgym findings.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "findings"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "type": {
            "enum": [
              "duplicate_invoice",
              "unallocated_payment",
              "wrong_fx_rate",
              "wrong_period"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "claimed_amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "currency": {
            "type": "string",
            "pattern": "^\\s*[A-Za-z]{3}\\s*$"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
